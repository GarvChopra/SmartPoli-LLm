# Copy to .env (never commit .env). Every value is optional.

# Which model decides what to do: "ollama" (local, default) or "cloud"
R2_BRAIN=ollama
R2_MODEL=qwen2.5:3b
# fast model for plain conversation (no tools). Use qwen2.5:3b for smarter, slower chat
R2_CHAT_MODEL=qwen2.5:1.5b
R2_OLLAMA_URL=http://localhost:11434

# Any OpenAI-compatible host (Groq, Gemini, OpenRouter, ...): easiest is to run  r2 cloud
# R2_BRAIN=openai
# R2_OPENAI_BASE_URL=https://api.groq.com/openai/v1
# R2_OPENAI_MODEL=
# R2_OPENAI_API_KEY=
#
# Tiered routing (all optional):
# R2_FAST_MODEL=    # small model for plain conversation
# R2_DEEP_MODEL=    # biggest model for planning / analysis / long tasks
# R2_PRIVATE_LOCAL=1  # requests containing secrets stay on this PC when Ollama is running

# Only used when R2_BRAIN=cloud (Anthropic)
R2_CLOUD_MODEL=claude-sonnet-5-5
ANTHROPIC_API_KEY=

# Server. R2 refuses to listen on anything but localhost; reach it from your phone with Tailscale.
R2_HOST=127.0.0.1
R2_PORT=8765
# The address your phone uses (for `r2 pair` links), e.g. your Tailscale name:
# R2_PUBLIC_URL=https://my-pc.tailnet-name.ts.net

# Learn which apps you use at which hour (records only program names, never titles or keystrokes).
# Wipe it any time with: r2 forget
R2_LEARN=0

# Where memory, tokens, logs and the browser profile live
R2_DATA_DIR=data
R2_MAX_STEPS=25

# Optional: Tavily search (without it, web_search uses free DuckDuckGo). Queries are masked and logged.
# TAVILY_API_KEY=

# ---- SmartPoli Care Navigator (eGain AI Agent Hackathon) ----
# Set GROQ_API_KEY to enable real Groq LLM multi-turn chat in `r2 care` (get a key at https://console.groq.com/keys)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
SMARTPOLI_API_KEY=smartpoli-demo-key

# Hosted public demo only (the Dockerfile sets R2_PROFILE=demo): safe tools only, fixed access code, rate limit.
# R2_PROFILE=demo
# R2_DEMO_CODE=choose-an-access-code
# R2_DEMO_TASKS_PER_HOUR=30
